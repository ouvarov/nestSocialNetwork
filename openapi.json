  "info": {
    "title": "Pulse API",
    "description": "Social network API: auth, posts, likes, chats",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token"
      }
    },
    "schemas": {
      "CreateAuthDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "example": "correct-horse-battery"
          },
          "userName": {
            "type": "string",
            "example": "Ada Lovelace"
          }
        },
        "required": [
          "email",
          "password",
          "userName"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "userName",
          "id",
          "imageUrl",
          "description",
          "created"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Access token, valid for 15 minutes"
          },
          "userData": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "access_token",
          "userData"
        ]
      },
      "LoginAuthDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "password": {
            "type": "string",
            "example": "pulse-demo-password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string",
            "description": "A URL returned by POST /api/upload for the caller"
          },
          "text": {
            "type": "string",
            "example": "Shipping a new release this weekend."
          }
        },
        "required": [
          "text"
        ]
      },
      "PostResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "text": {
            "type": "string"
          },
          "created": {
            "format": "date-time",
            "type": "string"
          },
          "likeCount": {
            "type": "number",
            "example": 3
          },
          "likedByMe": {
            "type": "boolean",
            "description": "Whether the caller liked this post"
          }
        },
        "required": [
          "id",
          "ownerId",
          "imageUrl",
          "text",
          "created",
          "likeCount",
          "likedByMe"
        ]
      },
      "PostPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostResponseDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as cursor to get the next page; null on the last page"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreateChatDto": {
        "type": "object",
        "properties": {
          "userIds": {
            "description": "Other members; the caller is always added",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "userIds"
        ]
      },
      "ChatIdDto": {
        "type": "object",
        "properties": {
          "chatId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "chatId"
        ]
      },
      "ChatSummaryDto": {
        "type": "object",
        "properties": {
          "chatId": {
            "type": "string",
            "format": "uuid"
          },
          "chatName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "chatId",
          "chatName"
        ]
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "senderId": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          },
          "sentAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "messageId",
          "senderId",
          "content",
          "sentAt"
        ]
      },
      "ChatDto": {
        "type": "object",
        "properties": {
          "chatName": {
            "type": "string",
            "description": "Empty string when the chat has no name"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessageDto"
            }
          }
        },
        "required": [
          "chatName",
          "messages"
        ]
      },
      "UpdateChatDto": {
        "type": "object",
        "properties": {
          "chatId": {
            "type": "string",
            "format": "uuid"
          },
          "newChatName": {
            "type": "string",
            "example": "Weekend plans"
          }
        },
        "required": [
          "chatId",
          "newChatName"
        ]
      },
      "UploadResponseDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "https://cdn.example.com/users/<id>/<uuid>.png"
          }
        },
        "required": [
          "url"
        ]
      },
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "disabled"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "disabled"
            ],
            "description": "\"disabled\" when REDIS_URL is not set"
          }
        },
        "required": [
          "ready",
          "database",
          "redis"
        ]
      }
    }
  }
}
