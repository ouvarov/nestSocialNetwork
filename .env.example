NODE_ENV=development
PORT=5000
PUBLIC_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3001

DATABASE_URL=postgres://user:password@localhost:5432/mydb
DATABASE_POOL_MAX=10

REDIS_URL=

# true only for local e2e runs; refused when NODE_ENV=production
RATE_LIMIT_DISABLED=false

# openssl rand -hex 32
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=

# set behind the Vercel proxy: only requests carrying it in x-origin-secret
# reach the API, and their x-real-ip is trusted for rate limits
ORIGIN_SECRET=

# local: files go to ./uploads, served at /uploads
# supabase: needs the service role key (server only, never in the client)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=images
